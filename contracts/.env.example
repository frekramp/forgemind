# --- Foundry deploy config (copy to .env, never commit the real one) ---

# LiteForge RPC (used by the `liteforge` alias in foundry.toml)
LITEFORGE_RPC_URL=https://liteforge.rpc.caldera.xyz/http

# Deployer key — must hold testnet zkLTC for gas. Faucet: https://liteforge.hub.caldera.xyz
PRIVATE_KEY=0xyour_deployer_private_key

# OPTIONAL — autonomous keeper address (a SECOND funded wallet). If set, the deploy wires
# it as the vault's agent so it can run agentClaimYield/agentSetMode for opted-in users.
KEEPER_ADDRESS=

# OPTIONAL — initial reward-pool seed in wei (default 0.02 zkLTC). Backs the simulated yield.
REWARD_SEED=

# OPTIONAL — for `forge verify` on the Blockscout explorer
BLOCKSCOUT_API_KEY=
